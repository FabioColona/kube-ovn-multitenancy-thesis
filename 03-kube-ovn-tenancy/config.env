# config.env — default values for the Kube-OVN tenancy scripts (03-kube-ovn-tenancy).
# Do NOT edit this file: put your own values in config.local.env (same folder, ignored by git).
# Priority: variables set in the shell > config.local.env > config.env.
# Example:  REPETITIONS=1 ./20-private-subnet.sh

# Names used by the scripts; they must match the files in manifests/.
NS_T="ns-t"
NS_U="ns-u"
NS_SHARED="ns-shared"
SUBNET_T="sub-t"
SUBNET_U="sub-u"

# Each probe is repeated this many times; a check passes only if all repetitions give the same, expected result.
REPETITIONS=5
# Seconds to wait after the pods are Ready, so that Kube-OVN has installed the ACLs of the private subnets.
SETTLE_SECONDS=10

# Custom VPCs (names must match manifests/50-custom-vpcs.yaml and 51-custom-pods.yaml).
NS_VT="ns-vt"
NS_VU="ns-vu"
VPC_T="vpc-t"
VPC_U="vpc-u"
SUBNET_VT="sub-vt"
SUBNET_VU="sub-vu"

# 40-port-security.sh: namespace of the test pods and an address of the pod CIDR that no pod uses (the test adds it to
# a pod as a fake source address). CHANGE it if 10.16.250.250 is outside your pod CIDR.
NS_PS="ns-ps"
PS_SPOOF_IP="10.16.250.250"

# 41-netpol-vpc.sh: label that the script puts on ns-vt (must match manifests/73-netpol-shared-allow-namespace.yaml).
NP_LABEL="netpol-test=allowed"

# 42-vpc-overlap.sh (names must match manifests/76-overlap-vpcs.yaml and 77-overlap-pods.yaml).
NS_O1="ns-o1"
NS_O2="ns-o2"
NS_O3="ns-o3"
VPC_O1="vpc-o1"
VPC_O2="vpc-o2"
