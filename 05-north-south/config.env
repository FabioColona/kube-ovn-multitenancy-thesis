# config.env — default values for the north-south scripts (05-north-south).
# Do NOT edit this file: put your own values in config.local.env (same folder, ignored by git).
# Priority: variables set in the shell > config.local.env > config.env.
#
# These scripts run on YOUR COMPUTER and reach the machines with SSH (optionally through a jump host).
# Machines are numbered by their position in NODES (1 = first). The roles below use those numbers.

# ---- How to reach the machines ----
# CHANGE: SSH name or address of every machine, in order. Machine 1 becomes the K3s server (control plane).
NODES="node1.example.org node2.example.org node3.example.org node4.example.org"
NODE_USER="ubuntu"          # CHANGE: SSH user (needs passwordless sudo: cloud images have it)
SSH_PORT="22"
SSH_JUMP=""                 # CHANGE: jump host as user@host when the machines are behind one; empty = direct
NODE_IFACE=""               # empty = detect (interface of the default route; same name expected on every machine)
NIC_PREFIX_FIX="24"         # Kube-OVN 1.13 ignores a /32 address on the NIC ("iface has no valid IP address"), and some clouds
                            # (CrownLabs) give /32 addresses. If the NIC address is a /32, the same address is added with this prefix
                            # length and the flag noprefixroute (no new route: routing does not change). Empty = never do it.

# ---- Roles (numbers = position in NODES) ----
CLUSTER_NODES="1 2 3"       # machines that join the Kubernetes cluster
FABRIC_NODE="4"             # machine that hosts the simulated customer network (fabric + customer namespaces).
                            # It may be outside the cluster (best: it does not compete for CPU with the gateways)
GATEWAY_NODES="1 2 3"       # candidates for the gateway role (labelled ovn.kubernetes.io/external-gw=true by the tests;
                            # a test with N gateways uses the first N of this list)

# ---- Software versions (the ones used for the results in the thesis) ----
K3S_VERSION="v1.34.6+k3s1"
KUBEOVN_VERSION="v1.13.0"

# ---- Cluster networks (see 02-kube-ovn-setup/config.env) ----
POD_CIDR="10.16.0.0/16"
SVC_CIDR="10.96.0.0/12"
JOIN_CIDR="100.64.0.0/16"

# ---- Simulated customer network ----
# External segment: a layer-2 network shared by the gateway nodes and the fabric. It is built with VXLAN between
# the machines, because the machines of a cloud usually share no layer-2 network (and a proxy ARP on the real
# network makes the duplicate address detection of the NAT Gateway fail).
EXT_NIC="ext0"                      # name of the interface that carries the external segment on every gateway node
EXT_VNI="200"                       # VXLAN identifier
EXT_MTU=""                          # empty = MTU of the NIC minus 50 (VXLAN overhead)
EXT_CIDR="172.31.30.0/24"           # external segment (the subnet "external" of Kube-OVN)
EXT_GATEWAY="172.31.30.1"           # the fabric on the external segment (gateway of the subnet)
EXT_POOL_START="100"                # Kube-OVN may use EXT_CIDR from this host number on (lower ones are excluded)
# Customer network behind the fabric: where iperf3 servers run.
CUST_CIDR="172.31.20.0/24"
CUST_FABRIC_IP="172.31.20.1"
CUST_HOST_IP="172.31.20.10"

# ---- Other ----
# Directory, in the home of the remote user, where lib/ and 02-kube-ovn-setup/ are copied.
REMOTE_DIR="kube-ovn-multitenancy-thesis"
# Image of the test pods.
CHECK_IMAGE="docker.io/library/busybox:1.36"

# ---- NAT Gateway test (30-nat-gateway.sh, 39-remove-nat-gateway.sh) ----
# Which external network the gateway uses:
#   segment = macvlan on EXT_NIC, the VXLAN segment of 10-external-network.sh (the duplicate address detection works)
#   nic     = macvlan on the REAL network interface of the gateway machine (reproduces the failure that a proxy ARP causes).
#             Needs the three NAT_NIC_* values below: use a free range of the real network.
NAT_EXTERNAL="segment"
NAT_GW_NODE=""                       # machine number that runs the gateway pod; empty = first of GATEWAY_NODES
NAT_NIC_CIDR=""                      # CHANGE (nic only): CIDR of the real network, e.g. 192.0.2.0/24
NAT_NIC_GATEWAY=""                   # CHANGE (nic only): its router
NAT_NIC_EXCLUDE=""                   # CHANGE (nic only): everything EXCEPT a few free addresses, e.g. 192.0.2.1..192.0.2.239
NS_NAT="ns-nat"                      # namespace of the tenant (bound to NAT_SUBNET)
NAT_VPC="nat-vpc"
NAT_SUBNET="nat-sub"; NAT_SUBNET_CIDR="192.168.50.0/24"; NAT_LAN_IP="192.168.50.254"   # LAN side of the gateway
NAT_GW="gw-nat"                      # name of the VpcNatGateway (its pod is vpc-nat-gw-<name>-0 in kube-system)
NAT_EXT_SUBNET="nat-ext"             # Kube-OVN subnet of the external network of the gateway
PROBE_IMAGE="docker.io/nicolaka/netshoot:latest"   # pods that generate traffic (curl, iperf3, ping)

# Multus (needed by the VPC NAT Gateway: the external interface is a macvlan NetworkAttachmentDefinition)
# The manifest is pinned to a version and recorded.
MULTUS_VERSION="v4.2.2"
MULTUS_MANIFEST="https://raw.githubusercontent.com/k8snetworkplumbingwg/multus-cni/${MULTUS_VERSION}/deployments/multus-daemonset-thick.yml"

# ---- OVN Gateway (31-ovn-gateway.sh): the gateway is configuration on the nodes, not a pod ----
OVNGW_VPC="ovn-vpc"
OVNGW_SUBNET="ovn-sub"
OVNGW_SUBNET_CIDR="192.168.70.0/24"
NS_OVNGW="ns-ovngw"
OVNGW_PROVIDER="ovngw"                 # ProviderNetwork on EXT_NIC of the gateway nodes
OVNGW_EXT_SUBNET="external"            # external subnet (EXT_CIDR) used by the OvnEips

# ---- Benchmark (40-benchmark.sh) and gateway failure (50-gateway-failure.sh) ----
BENCH_CLIENT_PODS="4"          # tenant pods that send at the same time (ECMP chooses the gateway by source address: use more than gateways)
BENCH_CLIENT_NODES=""         # machines that run the client pods; empty = every cluster machine except FABRIC_NODE (so that every flow crosses the overlay)
BENCH_FLOWS="1 4 16 64"        # parallel TCP streams per client pod (iperf3 -P)
BENCH_REPS="5"                 # repetitions of every point (mean and dispersion are computed on them)
BENCH_DURATION="10"            # seconds of every run (the first 2 are omitted by iperf3)
FAIL_REPS="5"                  # repetitions of the failure test
FAIL_PODS="4"                  # tenant pods that ping the customer host during the failure test
FAIL_INTERVAL="0.1"            # seconds between pings
FAIL_PHASE="12"                # seconds of every phase (before / failure / after restoring)
