# config.env — values for the flat-network CNI tests (Flannel, Calico, Cilium).
# Your own values go in config.local.env (not delivered, ignored by git): it overrides this file.

K3S_VERSION=v1.34.6+k3s1          # pinned: newer versions were not tested with these kernels
POD_CIDR=10.244.0.0/16            # CHANGE: must not overlap your LAN (for example, 192.168.0.0/16 breaks Calico on a LAN that uses it)
NODE_HOSTNAME=                    # CHANGE (optional): empty = leave the machine hostname unchanged

CALICO_VERSION=v3.28.0
CALICO_MODE=iptables              # iptables | ebpf
CALICO_BPF_DISABLE_CONNECT_LB=yes # ebpf only: needed on kernel 7.0 (the kernel rejects calico_sendmsg_v46); set no on other kernels
CILIUM_VERSION=v1.18.6            # the version used in the thesis
CILIUM_CLI_VERSION=v0.20.1        # CHANGE together with CILIUM_VERSION if needed
CILIUM_MODE=strict                # strict = Cilium replaces kube-proxy | legacy = keeps kube-proxy
CILIUM_KPR_STRICT=true            # value of kubeProxyReplacement in strict mode: "true" from 1.15, "strict" up to 1.14

REPETITIONS=5                     # repetitions of each test

# Read from the environment only (not set here):
#   FLANNEL_POLICY=on|off   10-install-flannel.sh: on keeps the K3s policy controller (control case, test 22); default off
#   HTTP_REQUESTS=30        32-side-door.sh: requests of each type
#   POLICY_SETTLE=10        32-side-door.sh: seconds waited after the HTTP rule is enforced
