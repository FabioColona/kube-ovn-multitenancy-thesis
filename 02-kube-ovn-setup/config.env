# config.env — default values for the Kube-OVN setup scripts (02-kube-ovn-setup).
# Do NOT edit this file: put your own values in config.local.env (same folder, ignored by git).
# Priority: variables set in the shell > config.local.env > config.env.
# Example:  SVC_CIDR=10.97.0.0/16 JOIN_CIDR=100.65.0.0/16 ./10-install-kube-ovn.sh

# ---- Software versions (the ones used for the results in the thesis) ----
K3S_VERSION="v1.34.6+k3s1"
KUBEOVN_VERSION="v1.13.0"

# ---- Node ----
# CHANGE: name given to the machine (and to the Kubernetes node). Empty = keep the current hostname.
NODE_HOSTNAME=""
# CHANGE: network interface used for the Geneve tunnels between nodes. Empty = interface of the default route.
NODE_IFACE=""
# CHANGE: IPv4 address of the node (used by K3s and Kube-OVN). Empty = first address of NODE_IFACE.
NODE_IP=""

# ---- Cluster networks ----
# They must not overlap with each other nor with the networks of the machine (00-preflight.sh checks it).
# With several sites interconnected by OVN-IC, EVERY site needs different values.
POD_CIDR="10.16.0.0/16"      # default subnet of the pods (subnet ovn-default)
SVC_CIDR="10.96.0.0/16"      # ClusterIP of the services (a /16, so that a second site can use 10.97.0.0/16)
JOIN_CIDR="100.64.0.0/16"    # subnet "join" between nodes and pods

# ---- Options ----
# yes = if Open vSwitch is already running on the host, stop and disable it (Kube-OVN brings its own inside a container).
ALLOW_STOP_HOST_OVS="no"
# Image used by the pods of the final connectivity checks.
CHECK_IMAGE="docker.io/library/busybox:1.36"
