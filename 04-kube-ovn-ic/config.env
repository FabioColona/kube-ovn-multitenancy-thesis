# config.env — default values for the OVN-IC scripts (04-kube-ovn-ic).
# Do NOT edit this file: put your own values in config.local.env (same folder, ignored by git).
# Priority: variables set in the shell > config.local.env > config.env.
#
# These scripts run on YOUR COMPUTER and reach the machines with SSH. They need three machines:
#   site A  : cluster of the first site (also hosts the OVN-IC database)
#   site B  : cluster of the second site
#   router  : the third machine: third member of the IC database (Raft). With the sites in one network it is not in the
#             path of the packets; with two networks it has one leg in each and forwards packets between them (no NAT)
# The values below are placeholders: put your own in config.local.env (see the README).

# ---- How to reach the machines (CHANGE: host, port and user of each one) ----
# SSH_JUMP: jump host as user@host when the machines are behind one; empty = direct.
SSH_JUMP=""
SITE_A_HOST="site-a.example.org"; SITE_A_PORT="22"; SITE_A_USER="ubuntu"
SITE_B_HOST="site-b.example.org"; SITE_B_PORT="22"; SITE_B_USER="ubuntu"
ROUTER_HOST="router.example.org"; ROUTER_PORT="22"; ROUTER_USER="ubuntu"

# ---- Site A ----
SITE_A_NAME="site-a"            # hostname given to the machine and name of the Kubernetes node
SITE_A_AZ="az-a"                # name of the OVN-IC zone
SITE_A_IFACE="eth0"             # CHANGE: interface used for the Geneve tunnels (ip -4 -o addr)
SITE_A_IP="192.0.2.11"          # CHANGE: address of the node on that interface
SITE_A_ROUTER_IP="192.0.2.1"     # CHANGE: address of the third machine (with a single network, the same in both sites)
SITE_A_POD_CIDR="10.16.0.0/16"
SITE_A_SVC_CIDR="10.96.0.0/16"
SITE_A_JOIN_CIDR="100.64.0.0/16"

# ---- Site B ----
SITE_B_NAME="site-b"
SITE_B_AZ="az-b"
SITE_B_IFACE="eth0"
SITE_B_IP="192.0.2.12"
SITE_B_ROUTER_IP="192.0.2.1"
SITE_B_POD_CIDR="10.17.0.0/16"
SITE_B_SVC_CIDR="10.97.0.0/16"
SITE_B_JOIN_CIDR="100.65.0.0/16"

# ---- OVN-IC ----
# Number of transit switches created by install-ic-server.sh (the script of Kube-OVN v1.13.0 uses 3). Every remote
# CIDR is learned once per transit switch (ECMP), so this is also the number of routes expected for it.
IC_TS_NUM="3"

# ---- Other ----
# Directory, in the home of the remote user, where lib/ and 02-kube-ovn-setup/ are copied.
REMOTE_DIR="kube-ovn-multitenancy-thesis"
# Image of the test pods.
CHECK_IMAGE="docker.io/library/busybox:1.36"

# ---- Tests between sites (30-*, 31-*) ----
# Namespaces used by the tests (must match the manifests in manifests/2x-*.yaml).
NS_NP="ic-np"            # namespace of the target and of the remote client
NS_NP_LOCAL="ic-np-local" # namespace of a local control client, labelled np=allowed
NS_SG="ic-sg"            # namespace of the Security Group test pods
SG_NAME="sg-ic"          # name of the SecurityGroup (the same on both sites)
# Repetitions of every probe (a probe = one ping and one TCP connection to port 8080).
REPETITIONS="5"

# ---- Tenants and VPCs of the tests 40-44 (must match manifests/40-* and 41-*) ----
# Namespace and address of every test pod; every pod serves HTTP on 8080.
NS_T_A="ns-t-a";  IP_T_A="10.80.0.20"   # tenant T, private subnet, site A
NS_U_A="ns-u-a";  IP_U_A="10.82.0.20"   # tenant U, private subnet, site A
NS_D="ns-d";      IP_D_A="10.16.0.30"   # default subnet, site A (pod d-a)
NS_VT="ns-vt";    IP_CT="10.90.0.20"    # tenant T, custom VPC vpc-t, site A (pod c-t)
NS_VU="ns-vu";    IP_CU="10.91.0.20"    # tenant U, custom VPC vpc-u, site A (pod c-u)
NS_T_B="ns-t-b";  IP_T_B="10.81.0.20"   # tenant T, private subnet, site B
NS_U_B="ns-u-b";  IP_U_B="10.83.0.20"   # tenant U, private subnet, site B
                  IP_D_B="10.17.0.30"   # default subnet, site B (pod d-b, same namespace name NS_D)
NS_VB="ns-vb";    IP_PB="10.60.0.20"    # custom VPC vpc-custom-b, site B (pod pb)

# ---- IC database with three members (12-ic-db-raft.sh, 50-*, 51-*) ----
# The three members are containers named ovn-ic-db: site A and site B (containerd of K3s, ctr), router (Docker).
# The order is the Raft one: the first address is the leader at the start.
IC_DB_IMAGE="kubeovn/kube-ovn:v1.13.0"
IC_DB_DIR="/opt/ovn-ic-db"      # host directories of the IC database members (private, not shared with ovn-central)
# Number of lost pings tolerated while a member is killed (one ping every 0.3 s plus its own duration).
IC_MAX_LOST="3"
