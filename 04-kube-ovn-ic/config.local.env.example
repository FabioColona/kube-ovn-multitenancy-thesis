# Copy to config.local.env (ignored by git) and fill the CHANGE lines. Example for three machines on the same network:
#   a = site A (K3s + Kube-OVN, hosts the OVN-IC database), b = site B (K3s + Kube-OVN), r = third member of the Raft cluster
#   (needs Docker: sudo apt install -y docker.io). The "router" is NOT in the path of the packets here: all three
#   machines are on the same network, so the tests do not exercise routing between two networks.
SSH_JUMP="user@jump.example.org"
SITE_A_HOST="node-x.example.org"; SITE_A_PORT="22"; SITE_A_USER="ubuntu"
SITE_B_HOST="node-x.example.org"; SITE_B_PORT="22"; SITE_B_USER="ubuntu"
ROUTER_HOST="node-x.example.org"; ROUTER_PORT="22"; ROUTER_USER="ubuntu"

# Interface and address of each machine (ip -4 -o addr; the same name is expected on all three)
SITE_A_IFACE="CHANGE";  SITE_A_IP="CHANGE"
SITE_B_IFACE="CHANGE";  SITE_B_IP="CHANGE"
# The router has a single address: put it in both lines
SITE_A_ROUTER_IP="CHANGE-address-of-machine-r"
SITE_B_ROUTER_IP="CHANGE-address-of-machine-r"
